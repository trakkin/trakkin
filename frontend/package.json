{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate:api && vite build",
    "clean": "rm -rf .svelte-kit build",
    "dev": "vite dev --host",
    "fix": "biome check --write --unsafe --formatter-enabled=false .",
    "format": "biome format --write .",
    "generate:api": "mkdir -p ../target/openapi && cargo run --locked --quiet --manifest-path ../Cargo.toml --bin export_openapi -- ../target/openapi/trakkin.openapi.json && openapi-typescript ../target/openapi/trakkin.openapi.json -o src/lib/api/generated/schema.ts",
    "lint": "biome check --formatter-enabled=false . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "setup": "pnpm exec playwright install chromium",
    "start": "vite preview --host 0.0.0.0 --port 5173",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@lucide/svelte": "^1.31.0",
    "bits-ui": "^2.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "openapi-typescript": "7.13.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
