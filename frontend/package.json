{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf .svelte-kit build",
    "dev": "vite dev --host",
    "fix": "biome check --write --unsafe --formatter-enabled=false .",
    "format": "biome format --write .",
    "lint": "biome check --formatter-enabled=false . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "setup": "pnpm exec playwright install chromium",
    "start": "vite preview --host 0.0.0.0 --port 5173",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:browser": "playwright test",
    "test:unit": "node --experimental-strip-types --test src/lib/api/*.test.ts src/lib/features/connections/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/svelte": "^1.49.0",
    "bits-ui": "^2.19.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "openapi-typescript": "7.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
