{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "trakkin",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions",
        "hverlin.mise-vscode",
        "redhat.vscode-yaml",
        "rust-lang.rust-analyzer",
        "svelte.svelte-vscode",
        "tamasfe.even-better-toml",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "forwardPorts": [3000, 5173, 8725],
  "portsAttributes": {
    "3000": {
      "label": "Docs"
    },
    "5173": {
      "label": "Frontend"
    },
    "8725": {
      "label": "Backend"
    }
  },
  "containerEnv": {
    "DO_NOT_TRACK": "1",
    "NEXT_TELEMETRY_DISABLED": "1",
    "MISE_TRUSTED_CONFIG_PATHS": "/workspaces"
  },
  "remoteEnv": {},
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces/trakkin",
  "mounts": [],
  "init": true,
  "remoteUser": "vscode",
  "updateContentCommand": "mise setup",
  "postCreateCommand": "mise prepare"
}
